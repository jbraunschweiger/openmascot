{
  "name": "@openmascot/react",
  "version": "0.1.0",
  "description": "React bindings for OpenMascot.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --external react"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jbraunschweiger/openmascot",
    "directory": "packages/react"
  },
  "keywords": [
    "mascot",
    "svg",
    "animation",
    "rigging",
    "character"
  ],
  "dependencies": {
    "@openmascot/core": "workspace:*",
    "@openmascot/web": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
