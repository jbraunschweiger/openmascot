{
  "name": "@openmascot/react",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Jakob Braunschweiger (https://github.com/jbraunschweiger)",
  "homepage": "https://jbraunschweiger.github.io/openmascot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbraunschweiger/openmascot.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/jbraunschweiger/openmascot/issues"
  },
  "description": "React bindings for OpenMascot: the <Mascot> component and useMascotRef().",
  "keywords": [
    "mascot",
    "character",
    "svg",
    "animation",
    "rigging",
    "pseudo-3d",
    "openmascot",
    "react",
    "react-component"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "dependencies": {
    "@openmascot/core": "workspace:^",
    "@openmascot/web": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
