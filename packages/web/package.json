{
  "name": "@openmascot/web",
  "version": "0.1.0",
  "description": "Browser runtime for OpenMascot: live DOM SVG renderer, player loop and <open-mascot> custom element.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": { "build": "tsup src/index.ts --format esm --dts --clean" },
  "repository": { "type": "git", "url": "https://github.com/jbraunschweiger/openmascot", "directory": "packages/web" },
  "keywords": ["mascot", "svg", "animation", "rigging", "character"],
  "dependencies": {"@openmascot/core": "workspace:*"}
}
