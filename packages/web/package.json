{
  "name": "@openmascot/web",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Jakob Braunschweiger (https://github.com/jbraunschweiger)",
  "homepage": "https://jbraunschweiger.github.io/openmascot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbraunschweiger/openmascot.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/jbraunschweiger/openmascot/issues"
  },
  "description": "Browser runtime for OpenMascot: live DOM SVG renderer, animation player and the <open-mascot> custom element.",
  "keywords": [
    "mascot",
    "character",
    "svg",
    "animation",
    "rigging",
    "pseudo-3d",
    "openmascot",
    "web-components",
    "custom-element",
    "dom"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "dependencies": {
    "@openmascot/core": "workspace:^"
  }
}
