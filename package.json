{
  "name": "openmascot-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "OpenMascot — an open-source engine for rigged, animated SVG brand mascots.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @openmascot/playground dev",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:playground": "pnpm --filter @openmascot/playground build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "embed": "node packages/characters/scripts/embed-svg.mjs",
    "framesheet": "tsx packages/cli/src/bin.ts framesheet",
    "openmascot": "tsx packages/cli/src/bin.ts",
    "check": "pnpm embed --check && pnpm typecheck && pnpm test",
    "size": "node scripts/size.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release:verify": "pnpm check && pnpm build && pnpm smoke:pack",
    "release": "pnpm release:verify && OPENMASCOT_RELEASE_VERIFIED=1 changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "esbuild": "0.27.7",
    "happy-dom": "^21.0.1",
    "playwright-core": "^1.64.1",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
